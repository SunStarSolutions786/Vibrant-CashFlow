rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return signedIn() && profile().active == true;
    }
    function admin() {
      return active() && profile().role == 'admin';
    }
    function editor() {
      return active() && profile().role in ['admin', 'backoffice'];
    }
    function dateOf(value) {
      let parts = value.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }
    function today() { return (request.time + duration.value(330, 'm')).date(); }
    function lockDays() {
      let path = /databases/$(database)/documents/appData/settings;
      return exists(path) ? get(path).data.editLockDays : 7;
    }
    function editable(date) {
      return admin() || dateOf(date) >= today() - duration.value(lockDays(), 'd');
    }
    function validTransaction(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && dateOf(d.date) <= today() && d.month == d.date[0:7]
        && d.source in ['cash', 'bank'] && (d.source != 'bank' || d.bankAccountId.size() > 0)
        && d.type in ['inflow', 'outflow', 'internal'] && d.status in ['categorized', 'uncategorized', 'void']
        && d.deposit is number && d.withdrawal is number
        && d.deposit >= 0 && d.withdrawal >= 0 && d.deposit != d.withdrawal
        && d.deposit < 1000000000000000 && d.withdrawal < 1000000000000000
        && d.inflowNet == (d.status == 'categorized' && d.type == 'inflow' ? d.deposit - d.withdrawal : 0)
        && d.outflowNet == (d.status == 'categorized' && d.type == 'outflow' ? d.withdrawal - d.deposit : 0)
        && d.hasClosingBalance == (d.status != 'void' && d.get('closingBalance', null) is number)
        && (d.status != 'categorized' || (
          d.categorySnapshot is map && d.verticalId == d.categorySnapshot.verticalId
          && d.headId == d.categorySnapshot.headId && d.subHeadId == d.categorySnapshot.subHeadId
          && d.categorySnapshot.appliesTo == (d.type == 'internal' ? 'both' : d.type)))
        && getAfter(/databases/$(database)/documents/dataMonths/$(d.month)).data.month == d.month;
    }
    function budgetLocked(month) {
      let path = /databases/$(database)/documents/budgetLocks/$(month);
      return getAfter(path).data.revision == (exists(path) ? get(path).data.revision : 0) + 1;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || admin());
      allow list: if admin();
      allow create, update: if admin() && request.resource.data.role in ['admin', 'backoffice', 'viewer']
        && request.resource.data.active is bool
        && (userId != request.auth.uid || (request.resource.data.role == resource.data.role && request.resource.data.active == true));
      allow delete: if admin() && userId != request.auth.uid;
    }

    match /transactions/{transactionId} {
      allow read: if active();
      allow create: if editor() && validTransaction(request.resource.data) && editable(request.resource.data.date)
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data._revision == 1
        && (!('importHash' in request.resource.data) || transactionId == 'import_' + request.resource.data.importHash);
      allow update: if editor() && editable(resource.data.date) && editable(request.resource.data.date)
        && validTransaction(request.resource.data) && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data._revision == resource.data.get('_revision', 0) + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'date', 'month', 'bankAccountId', 'bankName', 'bankSnapshot', 'cashVerticalId',
          'type', 'verticalId', 'headId', 'subHeadId', 'categorySnapshot',
          'withdrawal', 'deposit', 'closingBalance', 'hasClosingBalance', 'particulars', 'particulars2', 'remarksBank',
          'status', 'inflowNet', 'outflowNet', '_revision', '_operationId', 'updatedBy', 'updatedAt', 'savedAt', 'changeReason'
        ])
        && getAfter(/databases/$(database)/documents/transactions/$(transactionId)/history/$(string(request.resource.data._revision))).data.before == resource.data;
      allow delete: if false;
      match /history/{revision} {
        allow read: if active();
        allow create: if editor() && request.resource.data.actor == request.auth.uid
          && request.resource.data.before == get(/databases/$(database)/documents/transactions/$(transactionId)).data
          && revision == string(getAfter(/databases/$(database)/documents/transactions/$(transactionId)).data._revision)
          && request.resource.data.savedAt == request.time;
        allow update, delete: if false;
      }
    }

    match /budgets/{budgetId} {
      allow read: if active();
      allow create, update: if admin() && budgetLocked(request.resource.data.month)
        && request.resource.data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.budget is number && request.resource.data.budget >= 0
        && request.resource.data.booking is number && request.resource.data.booking >= 0
        && request.resource.data.updatedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/dataMonths/$(request.resource.data.month)).data.month == request.resource.data.month;
      allow delete: if admin() && budgetLocked(resource.data.month);
    }
    match /budgetLocks/{month} {
      allow read: if active();
      allow create: if admin() && request.resource.data.revision == 1;
      allow update: if admin() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /budgetReconciliations/{id} {
      allow read: if admin();
      allow create: if admin() && request.resource.data.actor == request.auth.uid
        && request.resource.data.savedAt == request.time && budgetLocked(request.resource.data.month);
      allow update, delete: if false;
    }
    match /bankBalanceSelections/{accountId} {
      allow read: if active();
      allow create, update: if editor() && request.resource.data.selectedBy == request.auth.uid
        && get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.bankAccountId == accountId
        && get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.date == request.resource.data.date
        && get(/databases/$(database)/documents/transactions/$(request.resource.data.transactionId)).data.hasClosingBalance == true;
    }

    match /dataMonths/{monthId} {
      allow read: if active();
      allow create, update: if editor() && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') && request.resource.data.month == monthId;
      allow delete: if admin();
    }

    match /appData/masterData {
      allow read: if active();
      allow write: if admin();
    }
    match /appData/settings {
      allow read: if active();
      allow create, update: if admin() && request.resource.data.editLockDays is int
        && request.resource.data.editLockDays >= 0 && request.resource.data.editLockDays <= 3650;
    }
    match /appData/mappingMemory {
      allow read: if active();
      allow write: if editor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
